{
  "name": "ucs-sc-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:docs": "npm run build && node -e \"const fs=require('fs'); if(fs.existsSync('docs/assets')) fs.rmSync('docs/assets', {recursive: true, force: true}); fs.cpSync('dist', 'docs', {recursive: true}); fs.writeFileSync('docs/.nojekyll', ''); fs.writeFileSync('dist/.nojekyll', '');\"",
    "preview": "vite preview",
    "sync-data": "python scripts/process_data.py",
    "test:e2e": "node tests/test_full_suite.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "papaparse": "^5.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.4",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
