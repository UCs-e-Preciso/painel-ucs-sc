# Microsoft Graph API / Autenticação OAuth2 (Client Credentials)
# Estes valores devem ser configurados nos "Secrets and variables" > "Actions" do seu repositório no GitHub.

# ID do Diretório (Inquilino / Tenant) da Microsoft Entra ID
MS_TENANT_ID=seu_tenant_id_aqui

# ID do Aplicativo (Client ID) registrado no portal do Azure
MS_CLIENT_ID=seu_client_id_aqui

# Segredo do Aplicativo (Client Secret) - NUNCA COLOQUE EM ARQUIVOS COMMITADOS
MS_CLIENT_SECRET=seu_client_secret_aqui

# Hostname do SharePoint da organização (Ex: universidade.sharepoint.com)
MS_SHAREPOINT_HOSTNAME=universidade.sharepoint.com

# (Opcional) Sobrescrever configurações padrão
# MS_SITE_PATH=sites/LabEscolasConhecimento/LabConservacaoGestaoCosteira
# MS_FILE_ID=1C8CC5B2-22C1-4801-9D7E-79237787568C
